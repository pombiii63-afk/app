rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Does the requesting user's Firebase Auth phone match the document's customer phone?
    function isCustomerPhone(phone) {
      return isAuthenticated() && (
        request.auth.token.phone_number == phone || 
        request.auth.token.phone_number == "+91" + phone ||
        request.auth.token.phone_number.replace("^\\+91", "") == phone.replace("^\\+91", "")
      );
    }

    // 1. Users Profile Rules
    match /users/{regNum} {
      // Any authenticated campus member can read student/partner directories for identification
      allow read: if isAuthenticated();
      
      // Allow registration or profile updates for authenticated users
      allow create, update: if isAuthenticated();
    }

    // 2. Orders Rules
    match /orders/{orderId} {
      // Authenticated users can read/list any campus order requests
      allow read: if isAuthenticated();
      
      // Allow placement if authenticated and customerPhone matches current auth phone
      allow create: if isAuthenticated() && isCustomerPhone(request.resource.data.customerPhone);
      
      // Updates allowed for transition statuses (accept, pickup, complete, rate)
      allow update: if isAuthenticated();
      
      // Allow deletion only if delete requester is the owner of the order
      allow delete: if isAuthenticated() && isCustomerPhone(resource.data.customerPhone);
    }

    // 3. Earnings Rules
    match /earnings/{earningId} {
      // Riders can only read their own earnings
      allow read: if isAuthenticated() && request.auth != null;
      // Allow creation of earnings registers on delivery completion
      allow create: if isAuthenticated();
      // Immutable historical ledger entries
      allow update, delete: if false;
    }

    // 4. Payments Rules
    match /payments/{paymentId} {
      // Customer can read their own secure payments log
      allow read: if isAuthenticated() && isCustomerPhone(resource.data.customerPhone);
      // Create payment log on successful payment capture
      allow create: if isAuthenticated() && isCustomerPhone(request.resource.data.customerPhone);
      // Payments ledger is immutable
      allow update, delete: if false;
    }

    // 5. Dispute Reports Rules
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated();
    }

    // 6. Notifications Rules
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated();
      allow create: if isAuthenticated();
    }
  }
}
