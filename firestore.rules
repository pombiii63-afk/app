rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Does the requesting user's ID match the document parent key?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Does the user's registered phone match?
    function isPhoneOwner(phone) {
      return isAuthenticated() && (request.auth.token.phone_number == phone || request.auth.token.phone_number.replace("^\\+91", "") == phone.replace("^\\+91", ""));
    }

    // 1. Users Profile Rules
    match /users/{regNum} {
      // Students/Riders can read any profile to recognize partners, but only write their own profile
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 2. Orders Rules
    match /orders/{orderId} {
      // Any authenticated student/rider can list the orders to see delivery requests
      allow read: if isAuthenticated();
      
      // Creating order is allowed if the caller represents themselves
      allow create: if isAuthenticated() && request.resource.data.customerPhone != null;
      
      // Update rule: Customers can cancel. Partners can accept or update status.
      allow update: if isAuthenticated();
      
      allow delete: if isAuthenticated() && resource.data.customerPhone == request.auth.token.phone_number;
    }

    // 3. Earnings Rules
    match /earnings/{earningId} {
      // Users can only view their own earnings list
      allow read: if isAuthenticated() && resource.data.partnerId != null;
      allow create, update: if isAuthenticated();
    }

    // 4. Dispute Reports Rules
    match /reports/{reportId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Notifications Rules
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
    }
  }
}
